<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Gimnasio Proveedores Dreams - Sistema de Reservas</title>
    <style>
        :root {
            --bg-principal: #080d1a;
            --bg-tarjeta: #0d1527;
            --bg-bloque: #15223e;
            --bg-pasado: #0a0f1d;
            
            /* Bordes definidos y reforzados */
            --borde-tarjeta: #1e2e4f;
            --borde-tarjeta-hover: #354d80;
            --borde-mio: #d4af37;
            
            --oro: #eab308;
            --oro-texto: #fde047;
            --texto-claro: #f8fafc;
            --texto-apagado: #64748b;
            --verde-cupos: #22c55e;
            --rojo-cancelar: #991b1b;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background-color: var(--bg-principal);
            color: var(--texto-claro);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Cabecera */
        header {
            background-color: var(--bg-tarjeta);
            border-bottom: 1.5px solid var(--borde-tarjeta);
            padding: 16px 32px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
        }

        .header-titulos h1 {
            font-size: 1.3rem;
            color: var(--oro-texto);
            font-weight: 700;
        }

        .header-titulos p {
            font-size: 0.85rem;
            color: var(--texto-apagado);
            margin-top: 2px;
        }

        .header-perfil {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .datos-usuario {
            text-align: right;
            font-size: 0.85rem;
        }

        .datos-usuario .nombre {
            font-weight: 700;
            color: var(--oro-texto);
            display: block;
        }

        .datos-usuario .detalle {
            color: var(--texto-apagado);
            font-size: 0.8rem;
        }

        .btn-header {
            background: #090e1c;
            color: var(--oro);
            border: 1px solid var(--borde-tarjeta);
            padding: 8px 14px;
            border-radius: 6px;
            font-size: 0.85rem;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            transition: all 0.2s ease;
            white-space: nowrap;
        }

        .btn-header:hover {
            border-color: var(--oro);
            color: #fff;
        }

        .btn-logout {
            color: #fca5a5;
            border-color: #7f1d1d;
        }

        .btn-logout:hover {
            background: #7f1d1d;
            color: #fff;
        }

        main {
            flex: 1;
            max-width: 1240px;
            width: 100%;
            margin: 20px auto;
            padding: 0 20px 40px;
        }

        /* Control de Semanas */
        .semana-control {
            display: flex;
            gap: 12px;
            margin-bottom: 16px;
        }

        .btn-semana {
            flex: 1;
            background: var(--bg-tarjeta);
            color: var(--texto-apagado);
            border: 1.5px solid var(--borde-tarjeta);
            padding: 10px 22px;
            border-radius: 8px;
            font-weight: 700;
            font-size: 0.95rem;
            cursor: pointer;
            transition: all 0.2s ease;
            text-align: center;
        }

        .btn-semana.activo {
            background: var(--oro);
            color: #000;
            border-color: var(--oro);
        }

        /* Barra de Días */
        .dias-contenedor {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 10px;
            margin-bottom: 18px;
        }

        .dia-card {
            background: var(--bg-tarjeta);
            border: 1.5px solid var(--borde-tarjeta);
            border-radius: 8px;
            padding: 12px 6px;
            text-align: center;
            cursor: pointer;
            transition: all 0.2s ease;
            position: relative;
        }

        .dia-card:hover:not(.bloqueado) {
            border-color: var(--oro);
        }

        .dia-card.activo {
            background: var(--bg-bloque);
            border-color: var(--oro);
            box-shadow: 0 0 10px rgba(234, 179, 8, 0.2);
        }

        .dia-card .etiqueta-nombre {
            font-size: 0.75rem;
            font-weight: 700;
            color: var(--texto-apagado);
            text-transform: uppercase;
            display: block;
        }

        .dia-card.activo .etiqueta-nombre {
            color: var(--oro-texto);
        }

        .dia-card .numero-fecha {
            font-size: 1.2rem;
            font-weight: 800;
            color: #fff;
            margin-top: 4px;
            display: block;
        }

        .dia-card.activo .numero-fecha {
            color: var(--oro);
        }

        .dia-card.bloqueado {
            background: var(--bg-pasado);
            border-color: #111a2e;
            opacity: 0.35;
            cursor: not-allowed;
        }

        /* Fila de Canceladas */
        .caja-canceladas {
            display: flex;
            align-items: center;
            gap: 12px;
            background: rgba(13, 21, 39, 0.85);
            border: 1.5px solid #7f1d1d;
            border-left: 4px solid #ef4444;
            border-radius: 8px;
            padding: 10px 16px;
            margin-bottom: 20px;
        }

        .label-canceladas {
            font-size: 0.85rem;
            font-weight: 800;
            color: #f87171;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            white-space: nowrap;
        }

        .fila-canceladas {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            align-items: center;
        }

        .chip-cancelada {
            background: #1c1524;
            color: #fca5a5;
            border: 1px solid #991b1b;
            padding: 4px 10px;
            border-radius: 6px;
            font-size: 0.85rem;
            font-weight: 700;
        }

        /* Grilla y Borde Reforzado en la Zona de Horas */
        .grilla-turnos {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: 16px;
        }

        .turno-card {
            background: var(--bg-tarjeta);
            border: 1.5px solid var(--borde-tarjeta);
            border-radius: 10px;
            padding: 16px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            min-height: 140px;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }

        .turno-card:hover:not(.pasado):not(.limite-alcanzado) {
            border-color: var(--borde-tarjeta-hover);
        }

        /* Tarjeta propia reservada */
        .turno-card.mio {
            border: 1.5px solid var(--borde-mio);
            box-shadow: 0 0 10px rgba(212, 175, 55, 0.15);
        }

        /* Horario pasado o límite diario */
        .turno-card.pasado,
        .turno-card.limite-alcanzado {
            background: var(--bg-pasado);
            border-color: #111a2e;
            opacity: 0.45;
        }

        .turno-card.pasado .turno-hora,
        .turno-card.limite-alcanzado .turno-hora {
            color: var(--texto-apagado);
        }

        .turno-encabezado {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 12px;
        }

        .turno-hora {
            font-size: 1.15rem;
            font-weight: 700;
            color: var(--oro-texto);
        }

        /* Badges estilo Píldora */
        .badge-pildora {
            font-size: 0.75rem;
            font-weight: 700;
            padding: 4px 10px;
            border-radius: 9999px;
            background: #090e1a;
            border: 1px solid #1a2744;
        }

        .badge-pildora.disponible {
            color: var(--verde-cupos);
            border-color: rgba(34, 197, 94, 0.3);
        }

        .badge-pildora.lleno {
            color: #ef4444;
            border-color: rgba(239, 68, 68, 0.3);
        }

        .badge-pildora.pasado {
            color: var(--texto-apagado);
            border-color: #1e293b;
        }

        .participantes-caja {
            font-size: 0.75rem;
            color: var(--texto-apagado);
            background: rgba(8, 13, 26, 0.6);
            border: 1px dashed var(--borde-tarjeta);
            padding: 6px 8px;
            border-radius: 6px;
            margin-bottom: 10px;
            line-height: 1.35;
        }

        /* Botones de acción */
        .btn-turno {
            width: 100%;
            padding: 12px 10px;
            border-radius: 8px;
            font-weight: 700;
            font-size: 0.9rem;
            cursor: pointer;
            border: none;
            transition: all 0.2s ease;
        }

        .btn-reservar {
            background: var(--oro);
            color: #000;
        }

        .btn-reservar:active {
            transform: scale(0.98);
        }

        .btn-cancelar {
            background: var(--rojo-cancelar);
            color: #f8fafc;
        }

        .btn-cancelar:active {
            transform: scale(0.98);
        }

        .btn-deshabilitado {
            background: #101626;
            color: #475569;
            cursor: not-allowed;
        }

        /* Toast de notificaciones */
        .alerta-toast {
            position: fixed;
            bottom: 24px;
            right: 24px;
            z-index: 99999;
            background: #0d1527;
            color: var(--oro-texto);
            border: 1.5px solid var(--oro);
            padding: 14px 20px;
            border-radius: 8px;
            font-size: 0.9rem;
            font-weight: 600;
            line-height: 1.4;
            white-space: pre-line;
            box-shadow: 0 8px 24px rgba(0,0,0,0.5);
            transition: opacity 0.4s ease, transform 0.4s ease;
        }

        /* -------------------------------------------------------------
           OPTIMIZACIONES RESPONSIVAS PARA MÓVILES (PANTALLAS <= 768px)
        ------------------------------------------------------------- */
        @media (max-width: 768px) {
            header {
                padding: 14px 18px;
                flex-direction: column;
                align-items: flex-start;
                gap: 12px;
            }

            .header-titulos h1 {
                font-size: 1.15rem;
            }

            .header-titulos p {
                font-size: 0.78rem;
            }

            .header-perfil {
                width: 100%;
                justify-content: space-between;
                flex-wrap: wrap;
                gap: 10px;
                border-top: 1px solid #142038;
                padding-top: 10px;
            }

            .datos-usuario {
                text-align: left;
                width: 100%;
                order: 1;
            }

            .header-perfil .btn-header {
                flex: 1;
                text-align: center;
                order: 2;
                padding: 9px 8px;
                font-size: 0.8rem;
            }

            main {
                margin: 14px auto;
                padding: 0 14px 30px;
            }

            /* Barra de Días: Scroll horizontal táctil sin deformarse */
            .dias-contenedor {
                display: flex;
                overflow-x: auto;
                scroll-snap-type: x mandatory;
                -webkit-overflow-scrolling: touch;
                padding-bottom: 6px;
                gap: 8px;
            }

            /* Ocultar barra de scroll para limpieza visual */
            .dias-contenedor::-webkit-scrollbar {
                display: none;
            }
            .dias-contenedor {
                -ms-overflow-style: none;
                scrollbar-width: none;
            }

            .dia-card {
                flex: 0 0 74px;
                scroll-snap-align: start;
                padding: 10px 4px;
            }

            .dia-card .numero-fecha {
                font-size: 1.1rem;
            }

            /* Fila de Canceladas en móvil */
            .caja-canceladas {
                flex-direction: column;
                align-items: flex-start;
                gap: 8px;
                padding: 10px 14px;
            }

            /* Grilla de turnos en columna única para fácil toque */
            .grilla-turnos {
                grid-template-columns: 1fr;
                gap: 12px;
            }

            .turno-card {
                padding: 14px 16px;
                min-height: auto;
            }

            .alerta-toast {
                left: 16px;
                right: 16px;
                bottom: 16px;
                font-size: 0.85rem;
            }
        }
    </style>
</head>
<body>

    <header>
        <div class="header-titulos">
            <h1>GIMNASIO PROVEEDORES DREAMS</h1>
            <p>(Máximo 4 personas por turno)</p>
        </div>
        <div class="header-perfil">
            <div class="datos-usuario">
                <span class="nombre"><%= usuario.nombre_completo %></span>
                <span class="detalle"><%= usuario.cargo %> | <%= usuario.area %> (<%= usuario.rol %>)</span>
            </div>
            <button id="btnNotif" class="btn-header" onclick="solicitarPermisoAvisos()">🔔 Activar Avisos</button>
            <a href="/logout" class="btn-header btn-logout">Cerrar Sesión</a>
        </div>
    </header>

    <main>
        <!-- Navegación Semana Actual / Semana Siguiente -->
        <div class="semana-control">
            <button class="btn-semana activo" id="btnSemanaActual" onclick="seleccionarSemana(0)">Semana Actual</button>
            <button class="btn-semana" id="btnSemanaSiguiente" onclick="seleccionarSemana(1)">Semana Siguiente</button>
        </div>

        <!-- Barra de Días -->
        <div class="dias-contenedor" id="barraDias"></div>

        <!-- Fila de Canceladas -->
        <div class="caja-canceladas" id="cajaCanceladas" style="display: none;">
            <span class="label-canceladas">Canceladas:</span>
            <div class="fila-canceladas" id="filaCanceladas"></div>
        </div>

        <!-- Grilla de Turnos Horarios -->
        <div class="grilla-turnos" id="grillaTurnos"></div>
    </main>

    <script>
        let semanaOffset = 0;
        let fechaActivaStr = '';

        const NOMBRES_DIAS = ['LUNES', 'MARTES', 'MIÉRCOLES', 'JUEVES', 'VIERNES', 'SÁBADO', 'DOMINGO'];

        function calcularLunes(offset) {
            const fecha = new Date();
            const diaSemana = fecha.getDay();
            const diferencia = (diaSemana === 0 ? -6 : 1) - diaSemana;
            fecha.setDate(fecha.getDate() + diferencia + (offset * 7));
            return fecha;
        }

        function esHoyOMañana(fechaStr) {
            const ahora = new Date();
            const hoyStr = ahora.toLocaleDateString('en-CA');
            const manana = new Date(ahora);
            manana.setDate(manana.getDate() + 1);
            const mananaStr = manana.toLocaleDateString('en-CA');
            return (fechaStr === hoyStr || fechaStr === mananaStr);
        }

        function construirBarraDias() {
            const barra = document.getElementById('barraDias');
            barra.innerHTML = '';

            const lunes = calcularLunes(semanaOffset);
            const hoyStr = new Date().toLocaleDateString('en-CA');
            let primerDiaHabilitado = null;

            for (let i = 0; i < 7; i++) {
                const fechaDia = new Date(lunes);
                fechaDia.setDate(lunes.getDate() + i);
                const str = fechaDia.toLocaleDateString('en-CA');

                const esPasado = str < hoyStr;

                if (!esPasado && !primerDiaHabilitado) {
                    primerDiaHabilitado = str;
                }

                const card = document.createElement('div');
                card.className = `dia-card ${esPasado ? 'bloqueado' : ''} ${str === fechaActivaStr ? 'activo' : ''}`;

                card.innerHTML = `
                    <span class="etiqueta-nombre">${NOMBRES_DIAS[i]}</span>
                    <span class="numero-fecha">${fechaDia.getDate()}</span>
                `;

                if (!esPasado) {
                    card.onclick = () => fijarDiaActivo(str);
                }

                barra.appendChild(card);
            }

            if (!fechaActivaStr || fechaActivaStr < hoyStr || (semanaOffset === 1 && !fechaActivaStr)) {
                fijarDiaActivo(semanaOffset === 0 ? hoyStr : primerDiaHabilitado);
            }
        }

        function seleccionarSemana(offset) {
            semanaOffset = offset;
            document.getElementById('btnSemanaActual').classList.toggle('activo', offset === 0);
            document.getElementById('btnSemanaSiguiente').classList.toggle('activo', offset === 1);
            fechaActivaStr = '';
            construirBarraDias();
        }

        function fijarDiaActivo(str) {
            fechaActivaStr = str;
            const tarjetas = document.querySelectorAll('.dia-card');
            const lunes = calcularLunes(semanaOffset);

            tarjetas.forEach((tarjeta, index) => {
                const dia = new Date(lunes);
                dia.setDate(lunes.getDate() + index);
                const coincide = dia.toLocaleDateString('en-CA') === fechaActivaStr;
                tarjeta.classList.toggle('activo', coincide);
                
                // Centrado automático en móviles al cambiar de día
                if (coincide && window.innerWidth <= 768) {
                    tarjeta.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
                }
            });

            cargarGrillaTurnos();
        }

        async function cargarGrillaTurnos() {
            if (!fechaActivaStr) return;
            const contenedor = document.getElementById('grillaTurnos');
            const cajaCanceladas = document.getElementById('cajaCanceladas');
            const filaCanceladas = document.getElementById('filaCanceladas');

            contenedor.innerHTML = '<p style="color: var(--texto-apagado); grid-column: 1/-1; text-align: center; padding: 20px 0;">Cargando turnos...</p>';

            try {
                const res = await fetch(`/api/horarios?fecha=${fechaActivaStr}`);
                const data = await res.json();
                if (!res.ok) throw new Error(data.error);

                const hoyStr = new Date().toLocaleDateString('en-CA');
                const horaActual = new Date().getHours();
                const esHoy = fechaActivaStr === hoyStr;

                const misReservasDelDia = data.bloques.filter(b => b.reservadoPorMi).length;
                const limiteAlcanzado = misReservasDelDia >= 2;

                const canceladasFuturas = (data.horasCanceladas || []).filter(hStr => {
                    const horaNum = parseInt(hStr.split(':')[0], 10);
                    return !esHoy || horaNum >= horaActual;
                });

                if (esHoyOMañana(fechaActivaStr) && canceladasFuturas.length > 0) {
                    filaCanceladas.innerHTML = canceladasFuturas
                        .map(h => `<span class="chip-cancelada">${h} hrs</span>`)
                        .join('');
                    cajaCanceladas.style.display = 'flex';
                } else {
                    cajaCanceladas.style.display = 'none';
                    filaCanceladas.innerHTML = '';
                }

                contenedor.innerHTML = '';

                data.bloques.forEach(b => {
                    const card = document.createElement('div');
                    const bloquePasado = esHoy && b.hora < horaActual;

                    let claseEstado = '';
                    if (bloquePasado) {
                        claseEstado = 'pasado';
                    } else if (b.reservadoPorMi) {
                        claseEstado = 'mio';
                    } else if (limiteAlcanzado) {
                        claseEstado = 'limite-alcanzado';
                    } else if (!b.disponible) {
                        claseEstado = 'lleno';
                    }

                    card.className = `turno-card ${claseEstado}`;

                    let participantesHtml = '';
                    if (b.participantes && b.participantes.length > 0) {
                        participantesHtml = `
                            <div class="participantes-caja">
                                ${b.participantes.map(p => `<div>• ${p.nombre} (${p.cargo} | ${p.area})</div>`).join('')}
                            </div>
                        `;
                    }

                    let botonHtml = '';
                    if (bloquePasado) {
                        botonHtml = `<button class="btn-turno btn-deshabilitado" disabled>Horario Pasado</button>`;
                    } else if (b.reservadoPorMi) {
                        botonHtml = `<button class="btn-turno btn-cancelar" onclick="cancelarTurno(${b.reservaId})">Cancelar Mi Reserva</button>`;
                    } else if (limiteAlcanzado) {
                        botonHtml = `<button class="btn-turno btn-deshabilitado" disabled>Límite Diario (2/2)</button>`;
                    } else if (b.disponible) {
                        botonHtml = `<button class="btn-turno btn-reservar" onclick="reservarTurno(${b.hora})">Reservar Cupo</button>`;
                    } else {
                        botonHtml = `<button class="btn-turno btn-deshabilitado" disabled>Sin Cupos</button>`;
                    }

                    let badgeClase = 'disponible';
                    if (bloquePasado || (limiteAlcanzado && !b.reservadoPorMi)) {
                        badgeClase = 'pasado';
                    } else if (b.ocupados >= b.capacidadMaxima) {
                        badgeClase = 'lleno';
                    }

                    card.innerHTML = `
                        <div>
                            <div class="turno-encabezado">
                                <span class="turno-hora">${b.horaTexto}</span>
                                <span class="badge-pildora ${badgeClase}">
                                    ${bloquePasado ? 'Finalizado' : `${b.ocupados} / ${b.capacidadMaxima}`}
                                </span>
                            </div>
                            ${participantesHtml}
                        </div>
                        ${botonHtml}
                    `;

                    contenedor.appendChild(card);
                });

            } catch (err) {
                contenedor.innerHTML = `<p style="color: #ef4444; grid-column: 1/-1; text-align: center;">Error: ${err.message}</p>`;
            }
        }

        async function reservarTurno(hora) {
            try {
                const res = await fetch('/api/reservar', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ fecha: fechaActivaStr, horaInicio: hora })
                });

                const data = await res.json();
                if (!res.ok) throw new Error(data.error);

                mostrarToast("✓ " + data.mensaje);
                cargarGrillaTurnos();
            } catch (err) {
                alert("No se pudo reservar: " + err.message);
            }
        }

        async function cancelarTurno(reservaId) {
            if (!confirm("¿Deseas cancelar tu reserva de este bloque horario?")) return;

            try {
                const res = await fetch('/api/cancelar-reserva', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ reservaId })
                });

                const data = await res.json();
                if (!res.ok) throw new Error(data.error);

                mostrarToast("✓ Reserva cancelada.");
                cargarGrillaTurnos();
            } catch (err) {
                alert("Error al cancelar: " + err.message);
            }
        }

        // Conexión SSE para notificaciones
        if (!!window.EventSource) {
            const canal = new EventSource('/api/notificaciones/stream');
            canal.onmessage = function(event) {
                try {
                    const data = JSON.parse(event.data);
                    mostrarToast(`Alguien ha cancelado una hora.\nDía: ${data.dia}\nHora: ${data.hora}`);
                    cargarGrillaTurnos();
                } catch (e) {
                    console.error("Error SSE:", e);
                }
            };
        }

        function solicitarPermisoAvisos() {
            if ("Notification" in window) {
                Notification.requestPermission().then(p => {
                    if (p === "granted") {
                        document.getElementById('btnNotif').style.display = 'none';
                        mostrarToast("Avisos activados con éxito.");
                    }
                });
            }
        }

        if (window.Notification && Notification.permission === "granted") {
            document.getElementById('btnNotif').style.display = 'none';
        }

        function mostrarToast(txt) {
            const toast = document.createElement('div');
            toast.className = 'alerta-toast';
            toast.innerText = txt;
            document.body.appendChild(toast);

            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateY(10px)';
                setTimeout(() => toast.remove(), 400);
            }, 5000);
        }

        construirBarraDias();
    </script>
